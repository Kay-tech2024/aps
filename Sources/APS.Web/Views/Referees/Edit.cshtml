@model EditUserViewModel

@{
    ViewBag.Title = ApsStrings.edit_user;
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<ul class="breadcrumb">
    <li>@Html.ActionLink(ApsStrings.homepage, "Index", "Home")</li>
    <li>@Html.ActionLink(ApsStrings.referees, "Index", "Referees")</li>
    <li>@ApsStrings.edit_user @Model.UserName</li>
</ul>

<h2 class="page-header">@ApsStrings.edit_user</h2>
<div class="box2 box2-info">

    @using (Html.BeginForm("Edit", "Referees", new { id = Model.UserId }, FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="form-horizontal">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-validation">
                    <h5>@ApsStrings.ValidationSummary</h5>
                    <div class="text-left">
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    </div>
                </div>
            }
            @Html.HiddenFor(model => model.UserId)

            <div class="form-group required">
                @Html.LabelFor(model => model.FullName, @ApsStrings.name, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-3"> رقم الهوية</label>
                <div class="col-md-9">
                    @Html.EditorFor(model => model.NationalId, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.NationalId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(expression: model => model.Email, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(expression: model => model.MobileNo, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.EditorFor(model => model.MobileNo, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.MobileNo, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(expression: model => model.UserName, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
                </div>
            </div>

            @if (Model.UserId == null)
            {

                <div class="form-group">
                    @Html.LabelFor(m => m.Password, new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>
                </div>
            }

            <div class="form-group hide">
                @Html.LabelFor(model => model.RoleId, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.DropDownListFor(model => model.RoleId, new SelectList(Model.Roles, dataValueField: "RoleId", dataTextField: "RoleName"), htmlAttributes: new { @class = "form-control" }, optionLabel: @ApsStrings.select)
                    @Html.ValidationMessageFor(model => model.RoleId, "", new { @class = "text-danger" })
                </div>
            </div>

            @if (!Utils.IsCollegeUser)
            {
                <div id="divCollege" class="form-group" style="display: none;">
                    @Html.LabelFor(model => model.CollegeId, htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        @Html.DropDownListFor(model => model.CollegeId, new SelectList(Model.Colleges, dataValueField: "Id", dataTextField: "Name"), htmlAttributes: new { @class = "form-control" }, optionLabel: @ApsStrings.select)
                        @Html.ValidationMessageFor(model => model.CollegeId, "", new { @class = "text-danger" })
                    </div>
                </div>

            }

            @if (!Utils.IsMajorUser)
            {
                <div id="divMajor" class="form-group" style="display: none;">
                    @Html.LabelFor(model => model.MajorId, htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-9">
                        @Html.DropDownListFor(model => model.MajorId, new SelectList(Model.Majors, dataValueField: "Id", dataTextField: "Name"), htmlAttributes: new { @class = "form-control" }, optionLabel: @ApsStrings.select)
                        @Html.ValidationMessageFor(model => model.MajorId, "", new { @class = "text-danger" })
                    </div>
                </div>

            }

            <div class="form-group">
                <div class="col-md-9 col-md-offset-3">
                    <div class="checkbox">
                        <label>@Html.EditorFor(model => model.IsActivated)&nbsp;@Html.LabelFor(model => model.IsActivated)</label>
                    </div>
                    @Html.ValidationMessageFor(model => model.IsActivated, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-9 col-md-offset-3">
                    <div class="checkbox">
                        <label>@Html.EditorFor(model => model.ForcePasswordChange)&nbsp;@Html.LabelFor(model => model.ForcePasswordChange)</label>
                    </div>
                    @Html.ValidationMessageFor(model => model.ForcePasswordChange, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-3 col-md-9">
                    <input type="submit" value="@ApsStrings.save" class="btn btn-primary btn-lg btn-block" />
                </div>
            </div>
        </div>
    }
</div>

@if (Model.UserId != null)
{
    <h2 class="page-header">
        @ApsStrings.change_password
    </h2>

    <div class="box2 box2-info">
        @using (Html.BeginForm("ChangePassword", "Users", new { UserId = Model.UserId }, FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m=>m.Id)
            <div class="form-group">
                @Html.LabelFor(m => m.Password, new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-3 col-md-9">
                    <input type="submit" value="Change" class="btn btn-primary btn-lg btn-block" />
                </div>
            </div>
        }
    </div>
}

@section Scripts
{
    <script type="text/javascript" nonce="@Html.ScriptNonce()">
        $('#RoleId').change(function () {
            toggleProvider($("#RoleId option:selected").text());
        });

        var toggleProvider = function (role) {
            switch (role) {
                case "@LangHelpers.Instance[ApsUserRole.ResearchUnitScretary.ToString()]":
                case "@LangHelpers.Instance[ApsUserRole.ResearchUnitHead.ToString()]":
                case "@LangHelpers.Instance[ApsUserRole.ResearchUnitCouncilMember.ToString()]":
                    $('#divCollege').show();
                    $('#divMajor').hide();
                    break;
                case "@LangHelpers.Instance[ApsUserRole.Referee.ToString()]":
                    $('#divCollege').hide();
                    $('#divMajor').show();
                    break;
                default:
                    $('#divCollege').hide();
                    $('#divMajor').hide();
                    break;
            }
        };

        toggleProvider($("#RoleId option:selected").text());
    </script>
}
@model APS.Web.Models.PublicationViewModel

@{
    ViewBag.Title = @ApsStrings.thesis_detals;
}

<div class="step-wizard-container2 @(Model.PublicationType == PublicationType.Thesis? "ro" : "")">

    <div class="step-wizard">
        <div class="progress2">
            <div class="progressbar2 empty"></div>
            <div id="prog" class="progressbar2"></div>
        </div>
        <ul>
            <li class="active">
                <a href="~/Publications/Create?requestId=@Model.RequestId" id="step1">
                    <span class="step2">1</span>
                    <span class="title2">@ApsStrings.create</span>
                </a>
            </li>
            <li class="">
                <a href="~/Publications/PublicationDetails?requestId=@Model.RequestId" id="step2">
                    <span class="step2">2</span>
                    <span class="title2">@ApsStrings.publication_details</span>
                </a>
            </li>
            <li class="">
                <a href="~/Publications/BankDetails?requestId=@Model.RequestId" id="step3">
                    <span class="step2">3</span>
                    <span class="title2">@ApsStrings.bank_details</span>
                </a>
            </li>

            @if (Model.PublicationType != PublicationType.Thesis)
            {
                <li class="">
                    <a href="~/Publications/Participant?requestId=@Model.RequestId" id="step4">
                        <span class="step2">4</span>
                        <span class="title2">@ApsStrings.co_researcher</span>
                    </a>
                </li>
            }

            <li class="">

                <a href="~/Publications/Agreement?requestId=@Model.RequestId" id="step@(Model.PublicationType != PublicationType.Thesis? 5:4)">

                    <span class="step2">@(Model.PublicationType != PublicationType.Thesis ? 5 : 4)</span>
                    <span class="title2">@ApsStrings.agreements</span>
                </a>
            </li>
        </ul>
    </div>
</div>

<h2>@ApsStrings.thesis_detals</h2>

@Html.ValidationSummary(false, "", htmlAttributes: new { @class = "text-danger" })

@using (Html.BeginForm("PublicationDetails", "Publications", new { requestId = Model.RequestId, RequestType = ViewBag.RequestType }, FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
@Html.AntiForgeryToken()

    @Html.Hidden("RequestId", Model.RequestId)
    @Html.Hidden("RequestType", Model.RequestType)
    <div class="form-group">
        @Html.LabelFor(m => m.ThesisTitle, new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.TextBoxFor(m => m.ThesisTitle, new { @class = "form-control", @placeholder = "عنوان الرسالة" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Degree, new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.RadioButtonFor(m => m.Degree, Degree.Master, new { @id = Degree.Master, @class = "radio-inline", @checked = "true" }) @ApsStrings.master
            @Html.RadioButtonFor(m => m.Degree, Degree.Phd, new { @id = Degree.Phd, @class = "radio-inline" }) @ApsStrings.phd
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Supervisor, new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.TextBoxFor(m => m.Supervisor, new { @class = "form-control", @placeholder = "المشرف" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.AsstSupervisor, new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.TextBoxFor(m => m.AsstSupervisor, new { @class = "form-control", @placeholder = "المشرف" })
        </div>
    </div>

    <div id="divCommitteeMembers">
        <br />
        <h4>@ApsStrings.discussion_committeemembers</h4>
        @{
            var index = -1;
        }

        @foreach (var c in Model.CommitteeMembers)
        {
            index++;
            <div class="form-group">
                <label class="control-label col-sm-3"> @ApsStrings.member_name @(index + 1)</label>
                <div class="col-sm-7">
                    @Html.TextBoxFor(m => m.CommitteeMembers[index], new { @class = "form-control", @placeholder = "" })
                </div>
            </div>
        }
    </div>

    <p class="text-left">
        <a id="btnAddRow" class="btn btn-success btn-xs">+ @ApsStrings.add</a>
        <br /><br />
    </p>

    <div class="form-group required">
        @Html.LabelFor(m => m.UniversityOther, new { @class = "control-label col-sm-3 text-center" })
        <div class="col-sm-9">
            @Html.TextBoxFor(model => model.UniversityOther, new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group required">
        @Html.LabelFor(m => m.CollegeOther, new { @class = "control-label col-sm-3 text-center" })
        <div class="col-sm-9">
            @Html.TextBoxFor(model => model.CollegeOther, new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.GPA, new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">
            @Html.DropDownListFor(model => model.GPA, new SelectList(ViewBag.GPAs, "Value", "Text"), ApsStrings.select, htmlAttributes: new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group required">
        @Html.LabelFor(m => m.DateOfDiscussion, new { @class = "control-label col-sm-3" })
        <div class="col-sm-9">

            <div id="DateOfDiscussionGreg" class="custom-date-picker input-group">
                @Html.TextBoxFor(m => m.DateOfDiscussion, new { @class = "form-control allow-edit" })
                <div class="input-group-btn">
                    <button type="button" class="custom-date-picker-button btn btn-default">&#x25a6;</button>
                    <button type="button" class="custom-date-picker-switch btn btn-info">@ApsStrings.hijri</button>
                </div>
            </div>
            <div id="DateOfDiscussionHijri" class="custom-date-picker input-group" data-hirji="1" data-custom-date-picker-link="#DateOfDiscussionGreg" style="display: none;">
                <input type="text" class="form-control" />
                <div class="input-group-btn">
                    <button type="button" class="custom-date-picker-button btn btn-default">&#x25a6;</button>
                    <button type="button" class="custom-date-picker-switch btn btn-info">@ApsStrings.gregorian</button>
                </div>
            </div>

            @Html.ValidationMessageFor(model => model.DateOfDiscussion, "", new { @class = "text-danger" })
        </div>
    </div>

            if (Model.Files != null && Model.Files.Count > 0)
            {
                <div class="row">
                    <h4 class="col-md-offset-3 col-md-6 text-center">@ApsStrings.uploaded_files</h4>
                </div>

                var i = 0;
                foreach (var item in Model.Files)
                {
                    <div class="form-group">
                        <div class="col-md-3"></div>
                        <div class="col-md-6">
                            @Html.ActionLink(!string.IsNullOrWhiteSpace(item.FileName) ? item.FileName : item.Type.ToString(), "Index", "GetFile", new { id = item.FileId }, new { @class = "btn btn-info btn-xs", target = "_blank" })

                            @(item.PageCount > 0 ? "  (" + ApsStrings.no_of_pages + ": " + item.PageCount + ")" : "")
                        </div>
                    </div>

                    <hr style="border: 1px dashed #ddd;" />

                    @Html.HiddenFor(m => m.Files[i].FileId)
                    @Html.HiddenFor(m => m.Files[i].Type)

                    i++;

                }

            }

            <div id="divUploadedFiles">
                <br />
                <h4>@ApsStrings.attachments</h4>

                @Html.Partial("~/Views/Shared/_FileUploadPartial.cshtml")
            </div>

            if (Model.Type == RequestType.RepublishRequest)
            {

                <div id="type">
                    <div style="background:lavender; padding:15px; margin:5px;">
                        <div class="form-group">
                            @Html.LabelFor(m => m.PublishType, new { @class = "control-label col-sm-2" })
                            <div class="col-sm-10">
                                @Html.RadioButtonFor(m => m.PublishType, PublishType.Governmental, new { @id = PublishType.Governmental, @class = "radio-inline", @checked = "true" }) @ApsStrings.governmental
                                @Html.RadioButtonFor(m => m.PublishType, PublishType.Commercial, new { @id = PublishType.Commercial, @class = "radio-inline" }) @ApsStrings.commercial
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Publisher, new { @class = "control-label col-sm-2" })
                            <div class="col-sm-10">
                                @Html.TextBoxFor(m => m.Publisher, new { @class = "form-control", @placeholder = ApsStrings.publisher })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.PublisherPlace, new { @class = "control-label col-sm-2" })
                            <div class="col-sm-10">
                                @Html.TextBoxFor(m => m.PublisherPlace, new { @class = "form-control", @placeholder = ApsStrings.publisher_place })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.DateOfPublish, new { @class = "control-label col-sm-2" })
                            <div class="col-sm-10">
                                @Html.TextBoxFor(m => m.DateOfPublish, new { @class = "form-control datepicker-lang", @placeholder = ApsStrings.publish_date })
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="pull-right wizard-nav">
                <input type="submit" id="submit" class="btn btn-primary wizard-fin" value="@ApsStrings.next_btn" data-current-step="2" />
            </div>
            }

@section scripts
{

    <script type="text/javascript" nonce="@Html.ScriptNonce()">

        $(document).ready(function () {
            var typereq = $('#RequestType').val();

            if (typereq == "PublishRequest") {
                $('#type').hide();
            }
            function setClasses(index, steps) {
                if (index < 0 || index > steps) return;
                if (index == 0) {
                    $(".step-wizard-container2 #prev").prop('disabled', true);
                } else {
                    $(".step-wizard-container2 #prev").prop('disabled', false);
                }
                if (index == steps) {
                    $(".step-wizard-container2 #next").text('done');
                } else {
                    $(".step-wizard-container2 #next").text('next');
                }
                $(".step-wizard-container2 ul li").each(function () {
                    $(this).removeClass();
                });
                $(".step-wizard-container2 ul li:lt(" + index + ")").each(function () {
                    $(this).addClass("done");
                });
                $(".step-wizard-container2 ul li:eq(" + index + ")").addClass("active")
                var p = index * (100 / steps);
                $(".step-wizard-container2 #prog").width(p + '%');
            }

            // initial state setup
            setClasses(1, $(".step-wizard-container2 .step-wizard ul li").length - 1);
        });

        $('#btnAddRow').on('click', function (e) {

            var div = $('#divCommitteeMembers');
            var elms = div.find('.form-group');

            var html = '';
            html += '<div class="form-group" data-index="' + elms.length + '">';
            html += '	<label class="control-label col-sm-3">@(ApsStrings.member_name) ' + (elms.length + 1) + '</label>';
            html += '	<div class="col-sm-7">';
            html += '		<input class="form-control" id="CommitteeMembers_' + (elms.length) + '_" name="CommitteeMembers[' + (elms.length) + ']" placeholder="" type="text" value="" />';
            html += '	</div>';
            html += '	<div class="col-sm-2">';
            html += '		<a href="#" class="btn btn-xs btn-warning btnRemoveRow">@ApsStrings.cancel</a>';
            html += '	</div>';
            html += '</div>';

            div.append(html);

            e.preventDefault();
            return false;

        });

        onDomInserted('.btnRemoveRow', function (el) {

            $(el).on('click', function (e) {

                var elm = $(el).closest('.form-group');

                var index = parseInt(elm.attr('data-index'));

                var div = $('#divCommitteeMembers');
                var elms = div.find('.form-group');

                for (var i = 0; i < elms.length; i++) {

                    if (index == i) {
                        elm.remove();
                    } else if (index < i) {
                        var $label = $(elms[i]).find('.control-label');
                        $label.html('@(ApsStrings.member_name) ' + (i));
                        $(elms[i]).find('#CommitteeMembers_' + i + '_').attr('id', 'CommitteeMembers_' + (i - 1) + '_').attr('name', 'CommitteeMembers[' + (i - 1) + ']');
                        $(elms[i]).attr('data-index', i - 1);
                    }
                }

                return false;

                var html = '';
                html += '<div class="form-group">';
                html += '	<label class="control-label col-sm-3">@(ApsStrings.member_name) ' + (elms.length + 1) + '</label>';
                html += '	<div class="col-sm-7">';
                html += '		<input class="form-control" id="CommitteeMembers_' + (elms.length) + '_" name="CommitteeMembers[' + (elms.length) + ']" placeholder="" type="text" value="" />';
                html += '	</div>';
                html += '	<div class="col-sm-2">';
                html += '		<a href="#" class="btn btn-xs btn-warning btnRemoveRow">@ApsStrings.cancel</a>';
                html += '	</div>';
                html += '</div>';

                div.append(html);

                e.preventDefault();
                return false;

            });
        });
    </script>

}
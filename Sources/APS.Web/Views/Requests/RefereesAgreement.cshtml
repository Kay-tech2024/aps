@model RefereeAgreementViewModel

@{
    ViewBag.Title = ApsStrings.referees_agreement;
}

<h2>@ApsStrings.referees_agreement</h2>
@using (Html.BeginForm("RefereesAgreement", "Requests", FormMethod.Post, new { @class = "form-horizontal" }))
{
@Html.AntiForgeryToken()

    <div>
        @Html.Raw(Model.AgreementText)
    </div>
    <div class="form-group">
        <label class="control-label ">To View the conditions click the link below.</label>
        <br />
        <br />
        <a class="btn btn-xs btn-success" target="_blank" href="@Url.Action("DownloadTemplate", "Documents", new { Id = Model.TemplateId })">@ApsStrings.download</a>
    </div>
    <div class="form-group">
        <label class="control-label col-md-3">@ApsStrings.Approval</label>
        <div class="col-md-6">
            @ApsStrings.approved
            @Html.RadioButtonFor(m => m.IsRefereeAgree, "approved")
            &nbsp;
            &nbsp;
            @ApsStrings.rejected
            @Html.RadioButtonFor(m => m.IsRefereeAgree, "Reject")
        </div>
    </div>

    <div class="box2 box2-info">
        <div class="row">
            <div class="form-group">
                <div class="col-md-6 col-md-offset-3">
                    <input id="btnSubmit" type="submit" value="@ApsStrings.submit" class="btn btn-primary btn-lg btn-block" />
                </div>
            </div>
        </div>
    </div>
}
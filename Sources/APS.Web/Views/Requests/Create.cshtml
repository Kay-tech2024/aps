@model PublishRequestViewModel

@{
    ViewBag.Title = ApsStrings.new_publish;
}

<ul class="breadcrumb">
    <li>@Html.ActionLink(ApsStrings.home, "Index", "Home")</li>
    <li>@Html.ActionLink(ApsStrings.requests, "Index", "Requests")</li>
    <li>@Html.ActionLink(ApsStrings.new_request, "Create", "Requests")</li>
    <li>@ApsStrings.new_publish</li>
</ul>

@using (Html.BeginForm("Create", "Requests", FormMethod.Post, new { id = "frmCreateRequest", enctype = "multipart/form-data", @class = "form-horizontal maximum-width" }))
{
@Html.AntiForgeryToken()

    @Html.AntiForgeryToken()

    if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-validation">
            <h5>@ApsStrings.ValidationSummary</h5>
            <div class="text-left">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            </div>
        </div>
    }

    <div class="box2 box2-info padding">

        <div class="form-group disabled">
            <label class="control-label col-md-3">@ApsStrings.name</label>
            <div class="col-md-6">
                <span class="form-control">@Model.Name</span>
            </div>
        </div>
    </div>

    <div class="box2 box2-info">
        <div class="row">

            <div class="form-group">
                <label class="control-label col-md-3">@ApsStrings.comments</label>
                <div class="col-md-6">
                    @Html.TextAreaFor(model => model.Comments, htmlAttributes: new { @class = "form-control", rows = 5, cols = 5, placeholder = @ApsStrings.comments })
                    @Html.ValidationMessageFor(model => model.Comments, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>

    <div class="box2 box2-info">
        <div class="row">
            <div class="form-group">
                <div class="col-md-6 col-md-offset-3">
                    <input id="btnSubmit" type="submit" value="@ApsStrings.submit" class="btn btn-primary btn-lg btn-block" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts
{

    <script type="text/javascript" nonce="@Html.ScriptNonce()">
    </script>
}
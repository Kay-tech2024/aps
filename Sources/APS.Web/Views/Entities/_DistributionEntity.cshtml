@model DistributionEntitiesViewModel

@{

    var index = ViewBag.Index != null && ViewBag.Index > 0 ? (int)ViewBag.Index : 0;
    var key = (int)ViewBag.Index;

    var dataKey = ViewBag.Index != null && ViewBag.Index > 0 ? Model.DistributionEntities[index].Id : -1;
    if (Model.DistributionEntities == null || Model.DistributionEntities.Count == 0)
    {
        Model.DistributionEntities = new List<DistributionEntityViewModel>
        { new DistributionEntityViewModel { } };
    }
    var id = ViewBag.IsTemplate == true ? "DistributionEntities_{index}" : "DistributionEntities_" + index;
}
<tr id="@id" data-index="@(ViewBag.IsTemplate == null? index + "" : "{index}")" data-key="@Model.DistributionEntities[index]">
    <td>
        @(ViewBag.IsTemplate == null ? (index + 1) + "" : "{order}")
    </td>
    <td>
        @Html.TextBoxFor(m => m.DistributionEntities[index].Name, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.DistributionEntities[index].Name)
    </td>
    <td class="form-group">
        @Html.TextBoxFor(m => m.DistributionEntities[index].NoOfCopies, new { @class = "form-control", @type = "number", @min = "0" })
    </td>
    <td>
        <a href="#" class="btnRemoveRow btn btn-danger" data-key="@dataKey">@ApsStrings.delete</a>
        @Html.HiddenFor(m => m.DistributionEntities[index].Id)
    </td>
</tr>


@model DistributionEntitiesViewModel
@{
    ViewBag.Title = ApsStrings.entities;
}

<ul class="breadcrumb">
    <li>@Html.ActionLink(ApsStrings.home, "Index", "Home")</li>
    <li>@ApsStrings.entities</li>
</ul>
<link rel="stylesheet" type="text/css" href="~/Content/css/bootstrap-datetimepicker@(ApsStrings.css_suffix).css" />
@Html.ValidationSummary(false)
@using (Html.BeginForm("Index", "Entities", FormMethod.Post, new { @class = "form-horizontal" }))
{
@Html.AntiForgeryToken()

    <div class="panel-group div-repeatable" data-key="DistributionEntities">
        <table id="tblDistributionEntities" class="table order-list table-bordered table-striped">
            <thead>
                <tr>
                    <td>@ApsStrings.s_no</td>
                    <td>@ApsStrings.entity_name</td>
                    <td>@ApsStrings.no_copies</td>
                </tr>
            </thead>
            <tbody class="div-repeatable">
                @{
                    var index = -1;
                }
                @foreach (var e in Model.DistributionEntities)
                {
                    index++;
                    ViewBag.Index = index;
                    @Html.Partial("~/Views/Entities/_DistributionEntity.cshtml", Model);
                }
            </tbody>
        </table>
        <a href="#" class="btnAddRow btn btn-success pull-right">@ApsStrings.add</a>
        <div class="row">
            <button type="submit" class="text-center btn btn-block btn-info">@ApsStrings.submit</button>
        </div>
    </div>
                    }
@{
            ViewBag.Index = 0;
            ViewBag.IsTemplate = true;
}

@this.ScriptBlock(

    @<script type="text/javascript" nonce="@Html.ScriptNonce()">
        var templates = {};
        templates.DistributionEntities = '@(Html.Raw(Html.Partial("~/Views/Entities/_DistributionEntity.cshtml", Model).ToHtmlString().Replace("\r\n", " ")))';
        $('.btnAddRow').on('click', function (e) {
            var div = $(this).parent();
            var key = div.attr('data-key');
            var elms = div.find('tbody tr');
            var rowHtml = templates[key];
            var index = elms.length;
            var el = $(rowHtml.replaceAll('{index}', index).replaceAll('{order}', index + 1).replaceAll('data-id="0"', 'data-id="' + index + '"').replaceAll('_0__', '_' + index + '__').replaceAll('[0]', '[' + index + ']'));
            el.find('input,select,textarea').val('');
            el.find('.field-validation-error').remove();
            div.find('table tbody').append(el);
            e.preventDefault();
            return false;
        });
        onDomInserted('.btnRemoveRow', function (el) {
            $(el).on('click', function (e) {
                var elm = $(el).closest('tr');
                var index = parseInt(elm.attr('data-index'));
                var div = elm.closest('.div-repeatable');
                var elms = div.find('tr');
                for (var i = 0; i < elms.length; i++) {

                    if (index == i) {
                        elm.remove();
                    } else if (index < i) {
                        var els = $(elms[i]).find('input,select,textarea');;

                        for (var j = 0; j < els.length; j++)
                        {
                            var el2 = $(els[j]);
                            var prop = el2.attr('name').split('.')[1];
                            el2.attr('id', 'DistributionEntities_' + (i - 1) + '_' + prop).attr('name', 'DistributionEntities[' + (i - 1) + '].' + prop);
                        }
                        $(elms[i]).attr('data-index', i - 1);
                    }
                }
                e.preventDefault();
                return false;
            });
        });
    </script>
        )


@model CoResearcherDictionaryModel

<h2> @ApsStrings.dictionary_details </h2>
<form class="form-horizontal" action="">
    <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
            <table id="table" class="table table-striped">
                <tr>

                    <td><label class="control-label " for="dictionarytype">@ApsStrings.majorof_dictionary </label></td>

                    <td>
                        @Html.DropDownList("MajorId", new SelectList(@ViewBag.Majors, "Text", "Value"), "Select", htmlAttributes: new { @class = "form-control" })
                    </td>
                </tr>
                <tr>

                    <td><label class="control-label " for="dictionarylanguage">@ApsStrings.dictionary_language </label></td>
                    <td>
                        @Html.DropDownList("languageId", new SelectList(@ViewBag.Majors, "Text", "Value"), "Select", htmlAttributes: new { @class = "form-control" })
                    </td>
                </tr>
                <tr>

                    <td><label class="control-label " for="dictionarytitle">@ApsStrings.dictionary_title </label></td>
                    <td>
                        @Html.TextBoxFor(m=>m.DictionaryTitle, new  {@class = "form-control" })
                    </td>
                </tr>
                <tr>

                    <td><label class="control-label " for="dictionaryoriginal">@ApsStrings.dictionary_title_original   </label></td>
                    <td>
                        @Html.TextBoxFor(m => m.OriginalDictionaryTitle, new { @class = "form-control" })
                    </td>
                </tr>
                <tr>

                    <td><label class="control-label " for="authorspeciality"> @ApsStrings.author_major  </label></td>
                    <td>
                        @Html.DropDownList("MajorAuthorId", new SelectList(@ViewBag.Majors, "Text", "Value"), "Select", htmlAttributes: new { @class = "form-control" ,@readonly = "readonly" })
                    </td>
                </tr>
                <tr>

                    <td><label class="control-label " for="recommendationnumber">@ApsStrings.recommendation_number </label></td>
                    <td>
                        @Html.TextBoxFor(m => m.OriginalDictionaryTitle, new { @class = "form-control" , @readonly = "readonly" })
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-sm-2" for="attachments"> @ApsStrings.attached_file_thes   </label>
        <div class="col-sm-10">
            <input type="file" class="form-control" id="attachments" placeholder="@ApsStrings.attached_file_thes    "
                   name="attachments">
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-sm-2"> @ApsStrings.is_published_before</label>
        <div class="checkbox">
            @Html.RadioButtonFor(m => m.SelectedAction, "governmental") @ApsStrings.governmental &nbsp;
            @Html.RadioButtonFor(m => m.SelectedAction, "commercial") @ApsStrings.commercial
        </div>
    </div>

    <div class="form-group">
        <div class="col-sm-offset-1 col-sm-3">
            <label class="control-label col-sm-2" for="publisher"> @ApsStrings.publisher</label>
            @Html.TextBoxFor(m => m.PublisherName, new { @class = "form-control", @readonly = "readonly" })
        </div>
        <div class="col-sm-offset-1 col-sm-3">
            <label class="control-label" for="placeofpublish"> @ApsStrings.publisher_place</label>
            @Html.TextBoxFor(m => m.PublisherPlace, new { @class = "form-control", @readonly = "readonly" })
        </div>
        <div class="col-sm-offset-1 col-sm-3">
            <label class="control-label col-sm-2" for="date"> @ApsStrings.date </label>
            @Html.TextBoxFor(m => m.date, new { @class = "form-control"})
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-sm-2" for="reasonsforreject"> @ApsStrings.reason_for_reject</label>
        <div class="col-sm-10">
            @Html.TextAreaFor(m => m.ReasonOfReject, new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-sm-2"> @ApsStrings.approve</label>
        <div class="col-sm-offset-2 col-sm-10">
            @Html.CheckBoxFor(m => m.ISApproved)
        </div>
    </div>

    <div class="box2 box2-info">
        <div class="row">
            <div class="form-group">
                <div class="col-md-6 col-md-offset-3">
                    <input type="submit" value="@ApsStrings.submit" class="btn btn-primary btn-lg btn-block" />
                </div>
            </div>
        </div>
    </div>
</form>
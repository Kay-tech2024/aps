@model IEnumerable<TemplateViewModel>

@{
    ViewBag.Title = "Templates";
}
<ul class="breadcrumb">
    <li><a href="@Url.Action("Index", "Home")">@ApsStrings.home</a></li>
    <li>@ApsStrings.templates</li>
</ul>

<div class="box2 box2-info">

    <table class="table">
        <tr>
            <th>
                @Html.DisplayName(@ApsStrings.template_name)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>

                    <label>@LangHelpers.Instance[item.TemplateKey]</label>
                </td>
                <td>
                    @Html.ActionLink(@ApsStrings.edit, "Edit", new { id = item.TemplateKey }, new { @class = "btn btn-info" })
                </td>
            </tr>
        }
    </table>
</div>
                    this.ScriptBlock(

                @<script type="text/javascript" nonce="@Html.ScriptNonce()">

         $('#selectChannel').change(function () {
             var value = $(this).val();
             var college = $(this).find('option:selected').attr('data-college');

             if (college === 'null') college = null;

             if (!value || value === '') return;

             if (college == null)
                 window.location.href = baseUrl + 'Home/ChangeUserRole?role=' + value;
             else
                 window.location.href = baseUrl + 'Home/ChangeUserRole?role=' + value + '&collegeId=' + college;
         });
                </script>
);


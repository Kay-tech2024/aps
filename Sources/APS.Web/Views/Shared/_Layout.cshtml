                                                                         $("#buttonImpersonate").click(function () {
                                                                             $('#impersonationModal').modal('toggle');
                                                                         });
                                                                         $(window).on('resize', function () {
                                                                             var win = $(this); //this = window

                                                                             if ((win.width() <= 960)) {
                                                                                 //$('body').addClass('minimenu');
                                                                                 $('#fa').removeClass('fa-arrow-circle-left').addClass('fa-arrow-circle-right');
                                                                                 $('#menuToggle').attr('title', 'Expand Menu');
                                                                             }
                                                                             if ((win.width() > 740)) {
                                                                                 //$('body').addClass('minimenu');
                                                                                 $('#fa').removeClass('fa-arrow-circle-left').addClass('fa-arrow-circle-right');
                                                                                 $('#menuToggle').attr('title', 'Expand Menu');
                                                                                 $('#sidecontent').removeAttr("style");
                                                                             }
                                                                             if ((win.width() > 960)) {
                                                                                 $('body').removeClass('minimenu');
                                                                                 $('#fa').removeClass('fa-arrow-circle-right').addClass('fa-arrow-circle-left');
                                                                                 $('#menuToggle').attr('title', 'Expand Menu');
                                                                             }
                                                                         });

                                                                         $('#burger').click(function (e) {
                                                                             e.stopPropagation();
                                                                             openNav();
                                                                         });
                                                                         $('#sidecontent').click(function (e) {
                                                                             e.stopPropagation();
                                                                         });
                                                                         $('body,html').click(function (e) {
                                                                             var win = $(this);
                                                                             if (win.width() <= 740) {
                                                                                 closeNav();
                                                                             }
                                                                         });
    </script>
)

    <script type="text/javascript" nonce="@Html.ScriptNonce()">
        function openNav() {
            document.getElementById("sidecontent").style.display = "block";
            document.getElementById("sidecontent").style.width = "250px";
        }

        function closeNav() {
            document.getElementById("sidecontent").style.width = "0";
        }
    </script>

    <!-- /.control-sidebar-menu -->
    <!-- Content Wrapper. Contains page content -->
    <div id="content" class="container-fluid">
        <div id="spinloader" class="loader"></div>
        @{
            var message = (string)null;
            var message_type = (string)null;
            var message_link = (string)null;

            if (!string.IsNullOrWhiteSpace(ViewBag.Message))
            {
                message = ViewBag.Message;
                message_type = ViewBag.MessageType;
                message_link = ViewBag.MessageLink;
            }
            else if (TempData["message"] != null && !string.IsNullOrWhiteSpace((string)TempData["message"]))
            {
                message = (string)TempData["message"];
                message_type = (string)TempData["message_type"];
                message_link = (string)TempData["message_link"];
            }

            if (!string.IsNullOrWhiteSpace(message))
            {

                if (string.IsNullOrWhiteSpace(message_type))
                {
                    message_type = "success";
                }

                if (!string.IsNullOrWhiteSpace(message_link))
                {
                    message = message.Replace("<link>", "<a href=\"" + message_link + "\">").Replace("</link>", "</a>");
                }

                this.ScriptBlock(
            @<script type="text/javascript" nonce="@Html.ScriptNonce()">
                        notify('@Html.Raw(message.Replace("'", "\\'").Replace("\r\n", "<br />"))', '@message_type');
            </script>
);
            }

        }

        @if (breadcrumb != null && !string.IsNullOrWhiteSpace(breadcrumb.Name))
        {

        <ul class="breadcrumb printbtn">
            <li><a href="~/">@ApsStrings.homepage</a></li>
            @while (breadcrumb != null && !string.IsNullOrWhiteSpace(breadcrumb.Name))
                {
                    if (!string.IsNullOrWhiteSpace(breadcrumb.Link))
                    {
            <li class="@(breadcrumb.Next == null? "active" : "")"><a href="@breadcrumb.Link">@breadcrumb.Name</a></li>
                    }
                    else
                    {
            <li class="@(breadcrumb.Next == null? "active" : "")">@breadcrumb.Name</li>
                    }

                    breadcrumb = breadcrumb.Next;
                }
        </ul>
        }

        @RenderBody()

        @Scripts.Render("~/Content/js/admin_js")
        @if (Utils.HasActualRolesAny(ApsUserRole.SystemAdmin))
        {
        <div id="impersonationModal" class="modal modal-sm fade" role="dialog" style="margin: 0 auto;">
            <div class="modal-dialog" style="width: auto;">

                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Impersonate user</h4>
                    </div>
                    <div class="modal-body" style="min-height: 300px;">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <input type="radio" name="imType" value="username" class="" checked /> By username
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <input type="radio" name="imType" value="role" class="" /> By role
                                </div>
                            </div>
                        </div>
                        <br />
                        <div id="divImUsername" class="row">
                            <div class="form-group">
                                <input name="imUsername" type="text" class="form-control" placeholder="Username.." />
                            </div>
                        </div>
                        <div id="divImRoles" class="row" style="display: none;">
                            <div class="form-group">

                                <select name="imRole" class="form-control">
                                    <option value="">Select role..</option>
                                    @foreach (var r in Utils.GetImpersonationRoles())
                                        {
                                    <option>@r</option>
                                        }
                                </select>
                            </div>

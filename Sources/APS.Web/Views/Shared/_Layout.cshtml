@{

    var preferences = CommonManager.GetUserPreferences();
    var controller = HttpContextManager.Current.Request.RequestContext.RouteData.Values["controller"].ToString().ToLower();
    var action = HttpContextManager.Current.Request.RequestContext.RouteData.Values["action"].ToString().ToLower();

    if (preferences.Menu == MenuPreference.DontCare)
    {
        preferences.Menu = MenuPreference.Expanded;
    }

    var breadcrumb = new BreadcrumbModel();

    if (ViewBag.Breadcrumb != null && ViewBag.Breadcrumb is BreadcrumbModel)
    {
        breadcrumb = ViewBag.Breadcrumb;
    }

}

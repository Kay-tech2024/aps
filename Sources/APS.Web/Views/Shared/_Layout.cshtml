            </div>
            @{
                var roleTip = "";
                var collegeName = "";
                var name = "";
                var roleName = "";
                var roles = Utils.GetUserRoles();
                var role = roles == null || roles.Length == 0 ? (ApsUserRole?)null : roles.FirstOrDefault();
                if (role != null)
                {
                    roleName = LangHelpers.Instance[role.ToString()];

                    if (Utils.CommonUtils.Roles != null && Utils.CommonUtils.Roles.Length > 0)
                    {
                        name = Utils.GetCurrentUserDetails().FullName;

                        roleTip = "Role: " + Utils.GetUserRoles().First().ToString();

                        if (Utils.IsCollegeUser)
                        {
                            collegeName = Utils.CommonUtils.DbContext.Colleges.Where(p => p.Id == Utils.CommonUtils.CurrentUser.CollegeId).Select(j => preferences.Language == LanguagePreference.Arabic ? j.NameArabic : j.NameEnglish).SingleOrDefault();
                        }

                    }

                    if (!string.IsNullOrWhiteSpace(collegeName))
                    {
                        roleTip += ", &#10;College: " + collegeName;
                    }
                }

            }

            <br />
            <p class="text-center" title="@Html.Raw(roleTip)">
                <a class="profile-link" href="~/Account/Profile"><em>@name</em></a>
            </p>

            <p class="text-center">
                <b>@roleName</b>

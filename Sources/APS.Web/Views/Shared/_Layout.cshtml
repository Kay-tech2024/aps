        <script type="text/javascript" nonce="@Html.ScriptNonce()">

            var showSessionExpiredMessage = function (locked) {

                var html = '<div id="expired_session"><div class="box">' + (locked ? '@ApsStrings.session_locked' : '@ApsStrings.session_expired') + ' <a href="#" class="btn btn-warning btn-xs" onclick="reloadUrl()">@ApsStrings.button_login</a> @ApsStrings.again.</div></div>';
                var el = $('#expired_session');

                if (el == null || el.length === 0) {
                    $(html).appendTo('body');
                } else {
                    el.show();
                }
            };

            var reloadUrl = function () {
                location.replace(location.pathname);
                return false;
            };
            @if (Utils.HasActualRolesAny(ApsUserRole.SystemAdmin))
            {
                <text>
            var validateImpersonation = function () {
                var isValid = true;
                var type = $('input[name=imType]:checked').val();

                switch (type) {
                    case 'username':
                        var username = $('input[name=imUsername]').val().trim();
                        if (username === '') isValid = false;
                        break;
                    case 'role':
                        var role = $('select[name=imRole').val();
                        if (!role || role === '') {
                            isValid = false;
                        }
                        break;
                    default:
                        isValid = false;
                        break;
                }
                if (!isValid)
                    $('#imButton').prop('disabled', true);
                else
                    $('#imButton').prop('disabled', false);
                return isValid;
            };

            var hideShowImpersonationFields = function () {
                var value = $('input[name=imType]:checked').val();
                switch (value) {
                    case 'username':
                        $('#divImUsername').show();
                        $('#divImRoles').hide();
                        break;
                    case 'role':
                        $('#divImUsername').hide();
                        $('#divImRoles').show();
                        if (isProviderRole($('select[name=imRole]').val())) {
                            $('#divImProviders').show();
                        }
                        if (isJpcRole($('select[name=imRole]').val())) {
                            $('#divImJpcs').show();
                        }
                        break;
                }
            };

            $('input[name=imType]').change(function () {
                hideShowImpersonationFields();
                validateImpersonation();
            });

            $('input[name=imUsername]').on('input', function () {
                validateImpersonation();
            });

            $('select[name=imRole]').on('change', function () {
                hideShowImpersonationFields();
                validateImpersonation();
            });

            validateImpersonation();

            $('#imButton').click(function () {

                if (validateImpersonation() === true) {
                    var url = baseUrl + 'Home/ChangeUserRole?';

                    if ($('input[name=imType]:checked').val() === 'username') {
                        url += 'username=' + $('input[name=imUsername').val();
                    } else {
                        var role = $('select[name=imRole').val();
                        url += 'role=' + role;
                    }
                    window.location.href = url;
                }
            });
            </text>

            }
        </script>

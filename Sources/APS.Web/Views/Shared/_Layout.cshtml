                <div style="max-width: 160px; margin: 0 auto">
                    <select id="selectChannel" class="no-selectpicker form-control" style="color: #000 !important;">
                        @if (Utils.IsCollegeRole(Utils.GetActualUserRole()))
                            {
                                var cName = @Utils.GetCollegeName(null, Utils.UserUtils.ActualCurrentUser.CollegeId);
                        <option @(!Utils.UserUtils.IsImpersonating ? "selected" : "") value="@Utils.GetActualUserRole()" data-college="@Utils.UserUtils.ActualCurrentUser.CollegeId">@(LangHelpers.Instance[Utils.GetActualUserRole().ToString()] + (string.IsNullOrWhiteSpace(cName) ? "" : "(" + cName + ")")) </option>
                            }
                            else
                            {
                        <option @(!Utils.UserUtils.IsImpersonating ? "selected" : "") value="@Utils.GetActualUserRole()">@LangHelpers.Instance[Utils.GetActualUserRole().ToString()]</option>
                            }

                        @foreach (var d in delegations)
                            {
                                var cName = @Utils.GetCollegeName(null, d.Value);
                        <option @(Utils.HasRolesAny(d.Key) && Utils.CurrentUser.CollegeId == d.Value ? "selected" : "")
                                value="@d.Key.ToString()" data-college="@d.Value">
                            @LangHelpers.Instance[d.Key.ToString()] @(string.IsNullOrWhiteSpace(cName) ? "" : "(" + cName + ")")
                        </option>
                            }

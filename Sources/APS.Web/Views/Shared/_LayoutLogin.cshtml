@{
    var isPostBack = HttpContextManager.Current.Request.HttpMethod == "POST";
    var preferences = CommonManager.GetUserPreferences();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author -frontend design" content="Syed Waqee Wali">

    <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <title>@ApsStrings.site_title_long</title>
    <script src="https://use.fontawesome.com/d05630c228.js"></script>
    <!-- Bootstrap -->

    <script type="text/javascript" nonce="@Html.ScriptNonce()">
        var lang = '@(preferences.Language == LanguagePreference.Arabic ? "ar" : "en")';
        var baseUrl = '@Utils.GetApplicationUrl()';
        var baseAjaxUrl = '@Utils.GetApplicationUrl()ajax/';
    </script>
    <script src="~/Content/js/jquery.js"></script>
    <link rel="stylesheet" href="~/Content/css/bootstrap@(ApsStrings.css_suffix).css" />
    <link rel="stylesheet" href="~/Content/css/bootstrap-select@(ApsStrings.css_suffix).css" />
    <link rel="stylesheet" href="~/Content/css/fonts.css" />
    <link rel="stylesheet" href="~/Content/css/login@(ApsStrings.css_suffix).css" />
    @*<link rel="stylesheet" href="~/Content/css/main@(ApsStrings.css_suffix).css" />*@
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
</head>
<body style="direction: @ApsStrings.css_dir;">
    <a href="@Url.Action("ContactUs", "About")">
        <span>@ApsStrings.contactUs</span>
    </a>
    <div class="container">

        <div class=" login-pg">
            @{
                var message = (string)null;
                var message_type = (string)null;
                var message_link = (string)null;

                if (!string.IsNullOrWhiteSpace(ViewBag.Message))
                {
                    message = ViewBag.Message;
                    message_type = ViewBag.MessageType;
                    message_link = ViewBag.MessageLink;
                }
                else if (TempData["message"] != null && !string.IsNullOrWhiteSpace((string)TempData["message"]))
                {
                    message = (string)TempData["message"];
                    message_type = (string)TempData["message_type"];
                    message_link = (string)TempData["message_link"];
                }

                if (!string.IsNullOrWhiteSpace(message))
                {

                    if (string.IsNullOrWhiteSpace(message_type))
                    {
                        message_type = "success";
                    }

                    if (!string.IsNullOrWhiteSpace(message_link))
                    {
                        message = message.Replace("<link>", "<a href=\"" + message_link + "\">").Replace("</link>", "</a>");
                    }

                    <div class="max-600-margin alert alert-@message_type">@Html.Raw(message)</div>
                }

            }

            <div>
                <img src="~/Content/aps/imgs/logo-1.png" class="img-responsive center-block" />
                    <h4 class="text-center">@ApsStrings.beta_version</h4>
                <br />
            </div>

            @RenderBody()

            @*<div class=" footer">

                    <div class="row">
                        <div class="col-md-12">
                            <p class="text-center kay-text">@ApsStrings.copyright</p>
                        </div>
                    </div>
                </div>*@
        </div>
    </div>
    <!-- Include all compiled plugins (below), or include individual files as needed -->
    @Scripts.Render("~/Content/js/admin_js_login")

    @RenderSection("scripts", false)

    @if (!Utils.IsLocalhost)
    {
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-115800046-1"></script>
        <script type="text/javascript" nonce="@Html.ScriptNonce()">
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());

            gtag('config', 'UA-115800046-1');
        </script>

        <!--Start of Zendesk Chat Script-->
        <script type="text/javascript" nonce="@Html.ScriptNonce()">
            window.$zopim || (function (d, s) {
                var z = $zopim = function (c) { z._.push(c) }, $ = z.s =
                    d.createElement(s), e = d.getElementsByTagName(s)[0]; z.set = function (o) {
                        z.set.
                        _.push(o)
                    }; z._ = []; z.set._ = []; $.async = !0; $.setAttribute("charset", "utf-8");
                $.src = "https://v2.zopim.com/?5ZDnD0FcELayweNNfu0yMY0HOI02suFO"; z.t = +new Date; $.
                    type = "text/javascript"; e.parentNode.insertBefore($, e)
            })(document, "script");
        </script>
        <!--End of Zendesk Chat Script-->

    }
</body>
</html>
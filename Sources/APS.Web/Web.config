  </connectionStrings>
  <appSettings>
    <add key="MVCGridShowErrorDetail" value="true" />
    <remove key="IsLocalhost" />
    <remove key="webpages:Version" />
    <remove key="webpages:Enabled" />
    <remove key="ClientValidationEnabled" />
    <remove key="UnobtrusiveJavaScriptEnabled" />
    <remove key="UseFakeServices" />
    <remove key="ApplicationUrl" />
    <add key="recaptchaPrivateKey" value="6LeaQz0UAAAAAEDZCRKGsSqzDurp7sOjTLy54YE0" />
    <add key="recaptchaPublicKey" value="6LeaQz0UAAAAANE9xEx5_k-yytX0QFNEtCprhi8F" />
    <add key="recaptchaApiVersion" value="2" />
    <add key="IsLocalhost" value="true" />
    <add key="TimeMachineEnabled" value="true" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="UseFakeServices" value="true" />

    <add key="NewRelic.AppName" value="APS.Web" />
    <add key="recaptchaPrivateKey" value="6LeaQz0UAAAAAEDZCRKGsSqzDurp7sOjTLy54YE0" />
    <add key="recaptchaPublicKey" value="6LeaQz0UAAAAANE9xEx5_k-yytX0QFNEtCprhi8F" />
    <add key="recaptchaApiVersion" value="2" />
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5.2" />
      </system.Web>
  -->
  <system.web>
    <sessionState regenerateExpiredSessionId="false" cookieless="UseCookies" cookieName="id" timeout="60" />
    <httpHandlers>
      <add verb="GET" path="~/Reports/ReportAsPdf/" type="CrystalDecisions.Web.CrystalImageHandler, CrystalDecisions.Web, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692FBEA5521E1304" />
    </httpHandlers>
    <authentication mode="None" />
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.6" maxRequestLength="10002400" executionTimeout="9600" enableVersionHeader="false" />
    <roleManager enabled="false" />
    <machineKey validationKey="E14E8A4175D8E700B9BFC95123BDD86CC0464D9EF1A760C678EF29D513738C2B9617CF528F2B10635C0BE402AFC4EE7DB5BE7E3F222D20AFA8E272CC380BFCE1" decryptionKey="0023867550653312920DF15B31620B828C8240ED73A70E1DC5D824DBF7E82C21" validation="SHA1" decryption="AES" />
    <!--<httpCookies httpOnlyCookies="true" requireSSL="true" />-->
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <clear />
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <!--<add name="Content-Security-Policy" value="default-src 'self'" />-->
      </customHeaders>
    </httpProtocol>
    <handlers>
      <add name="MiniProfiler" path="mini-profiler-resources/*" verb="*" type="System.Web.Routing.UrlRoutingModule" resourceType="Unspecified" preCondition="integratedMode" />
      <add name="MVCGridHandler" verb="*" path="MVCGridHandler.axd" type="MVCGrid.Web.MVCGridHandler, MVCGrid" />
    </handlers>
    <modules>
      <remove name="FormsAuthentication" />
      <remove name="ApplicationInsightsWebTracking" />
      <!--<remove name="DefaultAuthentication" />-->
      <remove name="OutputCache" />
      <remove name="AnonymousIdentification" />
      <remove name="RoleManager" />
    </modules>
    <validation validateIntegratedModeConfiguration="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
        <denyUrlSequences>
          <!--<remove sequence="/Content/files" />
          <add sequence="/Content/files" />-->
        </denyUrlSequences>
      </requestFiltering>
    </security>
    <httpErrors errorMode="Custom">
      <remove statusCode="403" />
      <error statusCode="403" path="/Errors/Index" responseMode="ExecuteURL" />
      <error statusCode="403" subStatusCode="14" responseMode="ExecuteURL" path="/Errors/Forbidden" />
    </httpErrors>
    <!--<rewrite>
      <rules>
        <remove name="HTTP to HTTPS redirect" />
        <rule name="HTTP to HTTPS redirect" enabled="false" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
      <outboundRules>
        <remove name="Add Strict-Transport-Security when HTTPS" />

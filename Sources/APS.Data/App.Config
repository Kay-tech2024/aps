<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>

    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework"
      type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
      requirePermission="false" />
  </configSections>
  <connectionStrings>
    <!--For Omar -->
    <add name="ApsDb" connectionString="Data Source=.;Initial Catalog=APS;Integrated Security=False;Connect Timeout=4200;User Id=sa;Password=__SET_ME__;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />

    <!-- For Gouse-->
    <!--<add name="ApsDb" connectionString="Data Source=192.168.100.175;Initial Catalog=APS;Integrated Security=False; User Id=sa; Password=__SET_ME__;Connect Timeout=4200;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />-->

    <!-- For KayServer-->
    <!--<add name="ApsDb" connectionString="Data Source=192.168.100.100,2544;Initial Catalog=APS2;Integrated Security=False; User Id=sa; Password=__SET_ME__;Connect Timeout=4200;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />-->
  </connectionStrings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>